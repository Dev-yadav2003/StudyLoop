# StudyLoop web app configuration.
#   cp .env.example .env.local     (git-ignored; restart `npm run dev` after changes)

# Where the API runs (`uv run lecnotes serve`).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Auth (sign-in by email link) — Dashboard → Project Settings → API Keys:
#   the Project URL and the *publishable* key (sb_publishable_…, or the legacy "anon" key).
# Both are public by design and end up in the browser bundle.
# Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
