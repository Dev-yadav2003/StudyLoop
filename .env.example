# StudyLoop API configuration.
#   cp .env.example .env      (never commit .env — it is git-ignored)
# Only the REQUIRED section must be filled in; everything else has a working default
# (commented out below, shown with that default).

# =============================================================================
# REQUIRED
# =============================================================================

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API v3 key (video metadata only; videos are never downloaded).
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials.
YOUTUBE_API_KEY=

# Postgres. On Supabase use the *Session pooler* string (Project → Connect): the direct
# host is IPv6-only. URL-encode special characters in the password (@ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Langfuse tracing (free tier is enough) — https://cloud.langfuse.com → project → API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com     # or https://us.cloud.langfuse.com

# Sign-in (Supabase Auth, email link). The API verifies sign-in tokens with the project's
# PUBLIC keys, so no Supabase secret is needed here. Unset = the library answers 503.
SUPABASE_URL=https://<project-ref>.supabase.co

# Accounts with unlimited use (comma-separated). Everyone else gets the guest allowance.
OWNER_EMAILS=you@example.com

# =============================================================================
# OPTIONAL — defaults shown
# =============================================================================

# --- Gemini keys and models ---------------------------------------------------
# Extra keys for failover, tried in order when a key is invalid or out of quota (same model
# first, then the next model). Requests stay paced per model across all keys: this is for
# resilience, not for multiplying free-tier quota (Google's terms forbid that).
# GEMINI_API_KEYS=key2,key3
# Primary model first, then fallbacks.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite
# LLM_RPM_OVERRIDE=                 # requests/minute per model; default from llm/models.py
# LLM_RETRY_ATTEMPTS=3
# LLM_TIMEOUT_S=180

# --- Guest allowance (lifetime, per account; owners are unlimited) ------------------
# GUEST_VIDEO_MINUTES=60
# GUEST_TOKEN_BUDGET=1000000        # ≈ 1 h of video + practice questions
# TOKENS_PER_VIDEO_MINUTE=15000     # charged per minute of video (measured 10.6k–14.8k)
# QA_TOKEN_COST=8000                # charged per practice-question set (measured 5k–10k)

# --- API and background worker ---------------------------------------------------
# CORS_ORIGINS=["http://localhost:3000"]   # JSON list of web origins allowed to call the API
# ADMIN_TOKEN=                      # set to enable /v1/admin/* (Authorization: Bearer …)
# RUN_WORKER=true                   # process jobs inside the API process
# WORKER_POLL_S=2
# JOB_LEASE_S=120                   # a job whose worker died is picked up after this
# JOB_MAX_ATTEMPTS=3

# --- Runtime ---------------------------------------------------------------------
# ENV=dev                           # dev | test | prod (tags traces)
# LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- Pipeline tuning (each change invalidates only the stages it affects) ---------
# PERCEIVE_FPS=1.0                  # frames per second Gemini samples from the video
# PERCEIVE_MEDIA_RESOLUTION=low     # low | medium | high (higher = more tokens)
# PERCEIVE_TIMEOUT_S=600
# PERCEIVE_THINKING_BUDGET=4096     # cap on Gemini's thinking per perceive call
# PERCEIVE_WINDOW_S=600            # longer videos are read in clips of ≤ 10 min (one reply is capped)
# CHUNK_MIN_S=120                   # lecture parts sent to the note writer: 2–5 minutes
# CHUNK_MAX_S=300
# FEATURES__MERGE=true              # merge duplicate notes across the lecture
# FEATURES__VERIFY=true             # fact-check every note against the lecture

# --- Prompt versions (prompts/<name>/v<N>.yaml; part of the cache key) -------------
# PERCEIVE_PROMPT_VERSION=2
# EXTRACT_PROMPT_VERSION=4
# MERGE_PROMPT_VERSION=5
# VERIFY_PROMPT_VERSION=3
# QA_PROMPT_VERSION=2

# --- Tests only ------------------------------------------------------------------
# TEST_DATABASE_URL=                # a disposable Postgres for integration tests
