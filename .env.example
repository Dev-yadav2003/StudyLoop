# Copy to .env and fill in. Never commit .env.

# --- required secrets ---
GEMINI_API_KEY=
YOUTUBE_API_KEY=
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- runtime ---
ENV=dev
LOG_LEVEL=INFO

# --- models ---
PERCEIVE_MODEL=gemini-2.5-flash
TEXT_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-3.1-flash-lite
# LLM_RPM_OVERRIDE=5            # default: free-tier RPM from llm/models.py
LLM_RETRY_ATTEMPTS=3
LLM_TIMEOUT_S=180

# --- perception ---
PERCEIVE_FPS=1.0
PERCEIVE_MEDIA_RESOLUTION=low
PERCEIVE_PROMPT_VERSION=1
PERCEIVE_TIMEOUT_S=600

# --- extraction ---
EXTRACT_PROMPT_VERSION=1
MERGE_PROMPT_VERSION=1
VERIFY_PROMPT_VERSION=1

# --- chunking (seconds) ---
CHUNK_MIN_S=120
CHUNK_MAX_S=300

# --- feature flags ---
FEATURES__MERGE=true
FEATURES__VERIFY=true
FEATURES__QA=false
