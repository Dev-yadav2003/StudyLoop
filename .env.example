# Copy to .env and fill in. Never commit .env.

# --- required secrets ---
GEMINI_API_KEY=
# Optional failover keys (comma-separated), tried in order when a key is invalid or out of
# quota — same model first, then the next model. Not for multiplying free-tier quota
# (Google's terms forbid that); requests stay paced per model across all keys.
GEMINI_API_KEYS=
YOUTUBE_API_KEY=
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- runtime ---
ENV=dev
LOG_LEVEL=INFO

# --- models ---
# Primary first, then fallbacks. (gemini-2.0-flash is retired: 404.)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite
# LLM_RPM_OVERRIDE=5            # default: free-tier RPM from llm/models.py
LLM_RETRY_ATTEMPTS=3
LLM_TIMEOUT_S=180

# --- perception ---
PERCEIVE_FPS=1.0
PERCEIVE_MEDIA_RESOLUTION=low
PERCEIVE_PROMPT_VERSION=1
PERCEIVE_TIMEOUT_S=600

# --- extraction ---
EXTRACT_PROMPT_VERSION=4
MERGE_PROMPT_VERSION=5
VERIFY_PROMPT_VERSION=3
QA_PROMPT_VERSION=2

# --- chunking (seconds) ---
CHUNK_MIN_S=120
CHUNK_MAX_S=300

# --- API + worker ---
# ADMIN_TOKEN=change-me                    # enables /v1/admin/* (Authorization: Bearer ...)
CORS_ORIGINS=["http://localhost:3000"]
RUN_WORKER=true
WORKER_POLL_S=2
JOB_LEASE_S=120
JOB_MAX_ATTEMPTS=3

# --- feature flags ---
FEATURES__MERGE=true
FEATURES__VERIFY=true

# --- sign-in + limits (step 10.1) ---
# Supabase Auth issues the sign-in tokens; the API verifies them with the project's PUBLIC
# keys (no Supabase secret needed). Unset = library endpoints answer 503.
SUPABASE_URL=https://<project-ref>.supabase.co
# Unlimited accounts (comma-separated). Everyone else gets the guest allowance, in total:
OWNER_EMAILS=you@example.com
# GUEST_VIDEO_MINUTES=60
# GUEST_TOKEN_BUDGET=1000000          # 1 h of video at TOKENS_PER_VIDEO_MINUTE + practice
# TOKENS_PER_VIDEO_MINUTE=15000       # measured 10.6k-14.8k on real lectures
# QA_TOKEN_COST=8000                  # one practice-question set (measured 5-10k)
